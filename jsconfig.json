{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "server/**/*.js",
    "src/**/*.js"
  ],
  "exclude": [
    "server/**/*.test.js",
    "dist",
    "node_modules"
  ]
}
