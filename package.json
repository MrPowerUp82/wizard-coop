{
  "name": "arcana-survivors",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "test": "node --test server/*.test.js",
    "sim": "node scripts/balance-sim.mjs",
    "fixtures:cpp": "node scripts/export-protocol-fixtures.mjs ../wizard_coop_cpp/tests/fixtures/protocol/snapshots.json",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "switch:install": "npm --prefix platforms/switch install",
    "switch:build": "npm --prefix platforms/switch run build",
    "switch:build:debug": "npm --prefix platforms/switch run build:debug",
    "switch:nro": "npm --prefix platforms/switch run build && npm --prefix platforms/switch run nro",
    "switch:nro:debug": "npm --prefix platforms/switch run build:debug && npm --prefix platforms/switch run nro",
    "switch:check": "npm --prefix platforms/switch run check",
    "switch:nro:emu": "npm --prefix platforms/switch run build -- --renderer=cpu && npm --prefix platforms/switch run nro:emu",
    "switch:nro:debug:emu": "npm --prefix platforms/switch run build:debug -- --renderer=cpu && npm --prefix platforms/switch run nro:emu",
    "vita:install": "npm --prefix platforms/vita install",
    "vita:runtime": "npm --prefix platforms/vita run runtime",
    "vita:build": "npm --prefix platforms/vita run build",
    "vita:build:debug": "npm --prefix platforms/vita run build:debug",
    "vita:vpk": "npm --prefix platforms/vita run vpk",
    "vita:vpk:debug": "npm --prefix platforms/vita run vpk:debug",
    "vita:check": "npm --prefix platforms/vita run check",
    "switch:nro:gpu": "npm --prefix platforms/switch run build -- --renderer=gpu && npm --prefix platforms/switch run nro",
    "vita:vpk:fresh": "npm --prefix platforms/vita run vpk:fresh"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
