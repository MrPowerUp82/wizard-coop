{
  "name": "arcana-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "test": "node --test server/*.test.js",
    "sim": "node scripts/balance-sim.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "switch:install": "npm --prefix platforms/switch install",
    "switch:build": "npm --prefix platforms/switch run build",
    "switch:build:debug": "npm --prefix platforms/switch run build:debug",
    "switch:nro": "npm --prefix platforms/switch run build && npm --prefix platforms/switch run nro",
    "switch:nro:debug": "npm --prefix platforms/switch run build:debug && npm --prefix platforms/switch run nro",
    "switch:check": "npm --prefix platforms/switch run check"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
