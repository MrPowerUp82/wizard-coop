{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "types": ["@nx.js/runtime"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
