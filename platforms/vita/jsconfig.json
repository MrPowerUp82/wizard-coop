{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "build"
  ]
}
